    "body": [
      "import { effect } from '@angular/core';",
      "",
      "constructor() {",
      "  effect(() => {",
      "    localStorage.setItem('${1:elementos}', JSON.stringify(this.${2:elementos}()));",
      "  });",
      "}"
    ],
    "description": "Guarda automáticamente el valor de un signal en localStorage"
  },
