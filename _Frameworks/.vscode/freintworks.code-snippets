  "Angular: servicio CRUD con API JSON": {
    "prefix": "ng-rest-service",
    "body": [
      "import { Injectable, inject } from '@angular/core';",
      "import { HttpClient } from '@angular/common/http';",
      "import { Observable } from 'rxjs';",
      "import { ${1:Elemento} } from '${2:../modelos/elemento}';",
      "",
      "@Injectable({",
      "  providedIn: 'root'",
      "})",
      "export class ${3:Elementos}Service {",
      "  private readonly http = inject(HttpClient);",
      "  private readonly apiUrl = '${4:https://jsonplaceholder.typicode.com/elementos}';",
      "",
      "  getAll(): Observable<${1:Elemento}[]> {",
      "    return this.http.get<${1:Elemento}[]>(this.apiUrl);",
      "  }",
      "",
      "  getById(id: number): Observable<${1:Elemento}> {",
      "    return this.http.get<${1:Elemento}>(this.apiUrl + '/' + id);",
      "  }",
      "",
      "  create(item: Omit<${1:Elemento}, 'id'>): Observable<${1:Elemento}> {",
      "    return this.http.post<${1:Elemento}>(this.apiUrl, item);",
      "  }",
      "",
      "  update(id: number, changes: Partial<${1:Elemento}>): Observable<${1:Elemento}> {",
      "    return this.http.patch<${1:Elemento}>(this.apiUrl + '/' + id, changes);",
      "  }",
      "",
      "  delete(id: number): Observable<void> {",
      "    return this.http.delete<void>(this.apiUrl + '/' + id);",
      "  }",
      "}"
    ],
    "description": "Genera un servicio HTTP con operaciones GET, POST, PATCH y DELETE"
  },
