  "Angular: lista reactiva con signals": {
    "prefix": "ng-signal-list",
    "body": [
      "import { computed, signal } from '@angular/core';",
      "import { ${1:Elemento} } from '${2:../modelos/elemento}';",
      "",
      "private readonly elementosSignal = signal<${1:Elemento}[]>([]);",
      "readonly elementos = this.elementosSignal.asReadonly();",
      "readonly totalElementos = computed(() => this.elementosSignal().length);",
      "",
      "agregarElemento(elemento: ${1:Elemento}): void {",
      "  this.elementosSignal.update(lista => [...lista, elemento]);",
      "}",
      "",
      "eliminarElemento(id: number): void {",
      "  this.elementosSignal.update(lista => lista.filter(elemento => elemento.id !== id));",
      "}",
      "$0"
    ],
    "description": "Crea estado de lista con signal, computed, alta y eliminación"
  },
  "Angular: componente con input y output": {
