  "Angular: cargar datos JSON en componente": {
    "prefix": "ng-load-json",
    "body": [
      "import { Component, OnInit, inject, signal } from '@angular/core';",
      "import { ${1:Elemento} } from '${2:./modelos/elemento}';",
      "import { ${3:Elementos}Service } from '${4:./servicios/elementos}';",
      "",
      "@Component({",
      "  selector: 'app-${5:elementos}',",
      "  standalone: true,",
      "  imports: [],",
      "  templateUrl: './${5:elementos}.html',",
      "  styleUrl: './${5:elementos}.css'",
      "})",
      "export class ${6:Elementos}Component implements OnInit {",
      "  private readonly servicio = inject(${3:Elementos}Service);",
      "  readonly elementos = signal<${1:Elemento}[]>([]);",
      "  readonly cargando = signal(true);",
      "  readonly error = signal<string | null>(null);",
      "",
      "  ngOnInit(): void {",
      "    this.cargarElementos();",
      "  }",
      "",
      "  cargarElementos(): void {",
      "    this.cargando.set(true);",
      "    this.error.set(null);",
      "    this.servicio.getAll().subscribe({",
      "      next: datos => {",
      "        this.elementos.set(datos);",
      "        this.cargando.set(false);",
      "      },",
      "      error: () => {",
      "        this.error.set('No se pudieron cargar los datos.');",
      "        this.cargando.set(false);",
      "      }",
      "    });",
      "  }",
      "  $0",
      "}"
    ],
    "description": "Carga elementos de un servicio JSON y expone estados de carga y error"
  },
  "Angular: persistir signal en localStorage": {
